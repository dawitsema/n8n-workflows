            "onError": "continueRegularOutput",
            "credentials": {
                "convertKitApi": {
                    "id": "FvJ5jXT6LL5kC5x3",
                    "name": "ConvertKit account"
                }
            }
        },
        {
            "parameters": {
                "amount": 1,
                "unit": "seconds"
            },
            "id": "wait-noshow-loop-001",
            "name": "Wait: 1 Second",
            "type": "n8n-nodes-base.wait",
            "typeVersion": 1,
            "position": [
                2048,
                0
            ],
            "webhookId": "dd55ee66-ff77-aa88-bb99-cc0011223344"
        }
    ],
