                  {
                      "parameters":  {
                                         "jsCode":  "const subscribers = $input.first().json.subscribers || [];\nif (!subscribers.length) return [];\nreturn subscribers.map(s =\u003e ({ json: { email: s.email_address, first_name: s.first_name || \"\", kit_id: s.id } }));"
