        {
            "parameters": {
                "jsCode": "const parsed = $('Code: Parse Zoom Event').first().json;\nconst closeData = $input.first().json;\n\nconst startTime = new Date(parsed.webinar_start_time);\nconst leaveTime = new Date(parsed.attendee_leave_time);\nconst durationMinutes = Math.round((leaveTime - startTime) / 1000 / 60);\nconst stayedFor30Min = durationMinutes >= 30;\n\nconst leadFound = (closeData.total_results || 0) > 0;\nconst lead = leadFound ? closeData.data[0] : null;\nconst qualifiesForNote = stayedFor30Min && leadFound;\n\nreturn [{\n  json: {\n    attendee_name: parsed.attendee_name,\n    attendee_email: parsed.attendee_email,\n    webinar_name: parsed.webinar_name,\n    webinar_start_time: parsed.webinar_start_time,\n    join_time: parsed.attendee_join_time,\n    leave_time: parsed.attendee_leave_time,\n    duration_minutes: durationMinutes,\n    stayed_30_min: stayedFor30Min,\n    lead_found: leadFound,\n    close_lead_id: lead ? lead.id : null,\n    close_lead_name: lead ? lead.display_name : null,\n    qualifies_for_note: qualifiesForNote\n  }\n}];"
            },
