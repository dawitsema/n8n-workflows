            "parameters": {
                "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst isValidation = body.event === 'endpoint.url_validation';\nconst plainToken = body?.payload?.plainToken || '';\n\nlet encryptedToken = '';\nif (isValidation) {\n  const crypto = require('crypto');\n  const secretToken = 'rbSHpyycQLCqLKW22BY4Lw';\n  encryptedToken = crypto\n    .createHmac('sha256', secretToken)\n    .update(plainToken)\n    .digest('hex');\n}\n\nreturn [{ json: { isValidation, plainToken, encryptedToken, originalBody: body } }];"
            },
