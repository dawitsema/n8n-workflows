        {
            "parameters": {
                "jsCode": "const body = $('Code: Handle Zoom Challenge').first().json.originalBody;\n\nconst eventType = body.event;\nconst payload = body.payload || {};\nconst participant = payload.object?.participant || {};\nconst webinarObj = payload.object || {};\n\nreturn [{ json: {\n  event_type: eventType,\n  webinar_id: String(webinarObj.id || ''),\n  webinar_name: webinarObj.topic || '',\n  webinar_start_time: webinarObj.start_time || '',\n  attendee_email: participant.email || participant.user_email || '',\n  attendee_name: participant.user_name || '',\n  attendee_join_time: participant.join_time || new Date().toISOString(),\n  attendee_leave_time: participant.leave_time || '',\n  registrant_id: participant.registrant_id || ''\n}}];"
            },
